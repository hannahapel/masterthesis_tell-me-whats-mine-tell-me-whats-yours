    "#!/usr/bin/env python3\n",
    "\"\"\"Reproducible DeBERTa versus gold-standard evaluation (Appendix 12.2).\n",
    "\n",
    "Run:\n",
    "  python "Appendix 12(2)_Validation and Performance Results Calculation.py" --input "Appendix 12(2)_Validation and Performance Results.xlsx" --output-dir evaluation_results",
    "\n",
    "The source workbook contains 63 matched records, 16 modality/crime labels, model\n",
    "scores and preassigned model codes. \n",
    "\"\"\"\n",
    "import argparse\n",
    "import csv\n",
    "import math\n",
    "from pathlib import Path\n",
    "from openpyxl import load_workbook\n",
    "\n",
    "LABELS = [\n",
    "    'modality_multimodal', 'modality_text', 'modality_audio', 'modality_image', 'modality_video',\n",
    "    'crime_synthetic_identity_fraud', 'crime_sexual_exploitation_ncii',\n",
    "    'crime_authority_impersonation', 'crime_financial_fraud_ceo',\n",
    "    'crime_hate_speech_defamation', 'crime_biometric_bypass', 'crime_political_disinfo',\n",
    "    'crime_document_forgery', 'crime_reputational_sabotage',\n",
    "    'crime_credential_theft', 'crime_fake_persona'\n",
    "]\n",
    "\n",
    "def read_data(path):\n",
    "    ws = load_workbook(path, read_only=True, data_only=True)['DeBERTa_vs_Gold']\n",
    "    rows = ws.iter_rows(values_only=True)\n",
    "    for row in rows:\n",
    "        if 'analysis_id' in row:\n",
    "            headers = [str(v) if v is not None else '' for v in row]\n",
    "            break\n",
    "    else:\n",
    "        raise ValueError('Header row containing analysis_id not found')\n",
    "    required = ['analysis_id'] + [f'{l}{s}' for l in LABELS for s in ('_score','_code')] + [f'gold_{l}' for l in LABELS]\n",
    "    missing = [k for k in required if k not in headers]\n",
    "    if missing: raise ValueError(f'Missing required columns: {missing}')\n",
    "    records = []\n",
    "    for row in rows:\n",
    "        d = dict(zip(headers,row))\n",
    "        if not d['analysis_id']: continue\n",
    "        for l in LABELS:\n",
    "            score = d[l+'_score']\n",
    "            if not isinstance(score,(int,float)) or not math.isfinite(score) or not 0 <= score <= 1:\n",
    "                raise ValueError(f'Invalid score for {d[\"analysis_id\"]}, {l}: {score}')\n",
    "            if d['gold_'+l] not in (0,1):\n",
    "                raise ValueError(f'Gold label must be 0/1 for {d[\"analysis_id\"]}, {l}')\n",
    "            if d[l+'_code'] not in (None,'','x','(x)'):\n",
    "                raise ValueError(f'Unexpected model code for {d[\"analysis_id\"]}, {l}: {d[l+\"_code\"]}')\n",
    "        records.append(d)\n",
    "    ids = [r['analysis_id'] for r in records]\n",
    "    if len(ids)!=len(set(ids)): raise ValueError('Duplicate analysis_id values')\n",
    "    return records\n",
    "\n",
    "def evaluate(gold,pred):\n",
    "    n00=sum(g==0 and p==0 for g,p in zip(gold,pred))\n",
    "    n01=sum(g==0 and p==1 for g,p in zip(gold,pred))\n",
    "    n10=sum(g==1 and p==0 for g,p in zip(gold,pred))\n",
    "    n11=sum(g==1 and p==1 for g,p in zip(gold,pred))\n",
    "    n=n00+n01+n10+n11\n",
    "    po=(n00+n11)/n\n",
    "    p_g1=(n10+n11)/n; p_p1=(n01+n11)/n\n",
    "    pe=p_g1*p_p1+(1-p_g1)*(1-p_p1)\n",
    "    kappa=(po-pe)/(1-pe) if not math.isclose(pe,1.0,abs_tol=1e-12) else None\n",
    "    precision=n11/(n11+n01) if n11+n01 else None\n",
    "    recall=n11/(n11+n10) if n11+n10 else None\n",
    "    f1=2*n11/(2*n11+n01+n10) if 2*n11+n01+n10 else None\n",
    "    return dict(n=n,n00=n00,n01=n01,n10=n10,n11=n11,po=po,pe=pe,kappa=kappa,\n",
    "                precision=precision,recall=recall,f1=f1)\n",
    "\n",
    "def write_csv(path, rows):\n",
    "    if not rows:return\n",
    "    with open(path,'w',encoding='utf-8',newline='') as f:\n",
    "        w=csv.DictWriter(f,fieldnames=list(rows[0].keys()))\n",
    "        w.writeheader();w.writerows(rows)\n",
    "\n",
    "def main():\n",
    "    parser=argparse.ArgumentParser(description=__doc__)\n",
    "    parser.add_argument('--input',required=True)\n",
    "    parser.add_argument('--output-dir',default='evaluation_results')\n",
    "    parser.add_argument('--start',type=float,default=0.0)\n",
    "    parser.add_argument('--stop',type=float,default=1.0)\n",
    "    parser.add_argument('--step',type=float,default=0.01)\n",
    "    args=parser.parse_args()\n",
    "    if args.step<=0 or args.start<0 or args.stop>1 or args.start>args.stop:\n",
    "        parser.error('Require 0 <= start <= stop <= 1 and step > 0')\n",
    "    data=read_data(args.input)\n",
    "    out=Path(args.output_dir);out.mkdir(parents=True,exist_ok=True)\n",
    "    baseline=[]; sweep=[]; matrices=[]\n",
    "    steps=int(round((args.stop-args.start)/args.step))\n",
    "    thresholds=sorted(set([round(args.start+i*args.step,10) for i in range(steps+1)]+[args.stop]))\n",
    "    for label in LABELS:\n",
    "        gold=[int(r['gold_'+label]) for r in data]\n",
    "        original=[int(r[label+'_code'] in ('x','(x)')) for r in data]\n",
    "        scores=[float(r[label+'_score']) for r in data]\n",
    "        base=evaluate(gold,original)\n",
    "        baseline.append(dict(label=label,mode='provided_model_codes',**base))\n",
    "        matrices.append(dict(label=label,**{k:base[k] for k in ('n00','n01','n10','n11')}))\n",
    "        for t in thresholds:\n",
    "            pred=[int(s>=t) for s in scores]\n",
    "            sweep.append(dict(label=label,threshold=t,**evaluate(gold,pred)))\n",
    "    write_csv(out/'kappa_by_category.csv',baseline)\n",
    "    write_csv(out/'confusion_matrices.csv',matrices)\n",
    "    write_csv(out/'threshold_sweep.csv',sweep)\n",
    "    # Macro-averaged kappa across defined per-label kappas; never treat it as pooled kappa.\n",
    "    valid=[r['kappa'] for r in baseline if r['kappa'] is not None]\n",
    "    macro=sum(valid)/len(valid) if valid else None\n",
    "    pooled_gold=[int(r['gold_'+l]) for r in data for l in LABELS]\n",
    "    pooled_pred=[int(r[l+'_code'] in ('x','(x)')) for r in data for l in LABELS]\n",
    "    pooled=evaluate(pooled_gold,pooled_pred)\n",
    "    write_csv(out/'aggregate_summary.csv',[\n",
    "        dict(metric='macro_mean_per_label_kappa',value=macro,description='Arithmetic mean of defined per-label kappa values'),\n",
    "        dict(metric='pooled_binary_kappa',value=pooled['kappa'],description='Pooled across all 16 labels and all posts'),\n",
    "        dict(metric='sample_size_posts',value=len(data),description='Number of distinct analysis_id records'),\n",
    "    ])\n",
    "    print(f'Evaluated {len(data)} posts and {len(LABELS)} binary labels.')\n",
    "    print(f'Macro mean category kappa: {macro:.6f}' if macro is not None else 'Macro kappa undefined')\n",
    "    print(f'Pooled binary kappa: {pooled[\"kappa\"]:.6f}' if pooled['kappa'] is not None else 'Pooled kappa undefined')\n",
    "    print('Outputs:',out.resolve())\n",
    "    for r in baseline:\n",
    "        print(f'{r[\"label\"]:39s} kappa={r[\"kappa\"] if r[\"kappa\"] is not None else \"undefined\"}')\n",
    "\n",
    "if __name__=='__main__':main()\n"
   ]
  }
